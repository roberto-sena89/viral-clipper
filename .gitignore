__pycache__/
*.py[cod]

# Pipeline output and intermediate files.
output/
out/
_work/
cache/

# Virtual environment
.venv/
venv/

# Local config overrides (may contain paths and API keys)
config.yaml
config.toml
.env

# Exported browser cookies. A cookies.txt holds live session tokens: committing
# one hands over the account. Needed here because the natural place to drop the
# file is the repo root, right next to the tool that consumes it.
#
# ``cookies`` without the .txt is yt-dlp's OWN cookie jar, which it rewrites
# into the CWD on every run. Tracked by the first two lines -- catch it here
# rather than discovering it as an untracked file that looks like a stray.
cookies
cookies.txt
*cookies*.txt
*[Cc]ookie*.jar
!requirements.txt

# Run logs and tooling scratch. ``.err`` is here because the web server's
# stderr redirect (wsrv.err) lands in the repo root next to wsrv.log and
# would otherwise show up as an untracked file.
*.log
*.err
.pytest_cache/
.openclaw-probe-out/
.workbuddy-ai/

# Local visual-test images (not part of the web UI)
web/1.jfif
web/2.jpg
web/3.jpg

# Cache of scrap thumbnails: third-party video frames downloaded so the result
# cards can show them. Rebuilt on demand, and not ours to redistribute -- so it
# stays out of the repo. Lives under web/ rather than output/ on purpose: the
# output tree is the clip library and must not collect other people's frames.
web/thumbs/

# Scratch: one-off debug scripts, preset previews and sample transcripts kept
# next to the repo while tuning. Not part of the tool.
_scratch/

# Snapshot of the .git directory that lost its packfiles on 2026-09-22.
# Kept on disk for reference until the history is confirmed unrecoverable.
.git-corrompido-*/

