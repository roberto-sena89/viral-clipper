{
  "name": "studio",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "check:models": "tsx server/modelCheck.ts",
    "doctor": "tsx server/doctor.ts",
    "test:models": "tsx --test server/modelCheck.test.ts server/modelCheckRetry.test.ts server/envFile.test.ts",
    "test": "npm run test:unit && npm run test:context && npm run test:loop && npm run test:routes && npm run test:gate && npm run test:cancel && npm run test:lock",
    "test:unit": "tsx --test server/clipOptions.test.ts server/envFile.test.ts server/modelCheck.test.ts server/modelCheckRetry.test.ts server/planParser.test.ts server/exitCodes.test.ts",
    "test:context": "tsx --test server/chatContext.test.ts server/chatContextRoute.test.ts",
    "test:loop": "tsx --test server/llmContinuation.test.ts",
    "test:routes": "tsx --test server/studioRoutes.test.ts",
    "test:gate": "tsx --test server/gateFlow.test.ts",
    "test:cancel": "tsx --test server/cancelRun.test.ts",
    "test:lock": "tsx --test server/singleRun.test.ts",
    "test:llm": "tsx --test server/gateLlm.test.ts",
    "smoke": "tsx server/studioSmoke.ts",
    "verify:build": "tsx server/previewProbe.ts"
  },
  "dependencies": {
    "@tdesign-react/aigc": "^0.1.0-alpha.1",
    "@tdesign-react/chat": "^1.0.2",
    "better-sqlite3": "^12.6.2",
    "express": "^4.18.2",
    "lucide-react": "^0.563.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.13.0",
    "tdesign-icons-react": "^0.5.0",
    "tdesign-react": "^1.12.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "less": "^4.3.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2",
    "vite": "^5.0.10"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.63.5"
  }
}
