{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    // O projeto nao tem lint. Estas duas flags sao o unico gate estatico que
    // sobrou para "simbolo declarado e nunca usado", e liga-las ja pagou: o
    // `auth` de doctor.ts era um resultado calculado e descartado, e o descarte
    // escondia um falso negativo (ver o comentario na secao 2 do doctor).
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": false
  },
  "include": ["src"]
}
